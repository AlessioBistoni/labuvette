# Copia queste variabili in file locali (non in git), poi:
#   npx prisma migrate deploy
#   npx prisma db seed
#
# `.env` — Prisma CLI legge solo questo file per default.
#   DATABASE_URL → path relativo alla cartella di `schema.prisma` (quindi `prisma/dev.db`).
#
# `.env.local` — Next.js (es. AUTH_SECRET, minimo 32 caratteri in produzione).
#
# Primo admin dopo seed: alessio.bistoni@labuvette.local

DATABASE_URL="file:./dev.db"
AUTH_SECRET=cambia-questa-stringa-con-almeno-trentadue-caratteri
