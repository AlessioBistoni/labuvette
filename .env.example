# Locale — copia in `.env` e `.env.local` (non committare i file con segreti reali).
#
# Sviluppo:
#   npx prisma migrate deploy
#   npx prisma db seed
#
# Primo admin dopo seed:
#   nome utente: alessio
#   password: (quella impostata nel seed)

# Prisma — in locale SQLite (path relativo a prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Produzione Vercel — Turso (SQLite remoto). Crea un DB su https://turso.tech
# oppure dalla Vercel Marketplace, poi:
#   turso db show <nome> --url
#   turso db tokens create <nome>
# DATABASE_URL="libsql://nome-org-nome-db.turso.io"
# TURSO_DATABASE_URL="libsql://nome-org-nome-db.turso.io"
# TURSO_AUTH_TOKEN="eyJ..."

# JWT sessioni — minimo 32 caratteri. In locale può essere qualsiasi stringa lunga.
# Su Vercel usa solo lettere minuscole, cifre, - e _ (niente / + =).
# Genera un valore sicuro: openssl rand -hex 32
AUTH_SECRET=cambia-questa-stringa-con-almeno-trentadue-caratteri

# Su Vercel / tunnel Cloudflare non serve SITE_URL per i redirect: usiamo path relativi.
# Il tunnel quick (trycloudflare.com) cambia URL a ogni avvio: conmotiona il nuovo link agli utenti.
# Imposta le stesse variabili nella dashboard del progetto:
#   Project → Settings → Environment Variables
#   oppure: vercel env add AUTH_SECRET production
#
# AUTH_SECRET  → obbligatoria, ≥ 32 caratteri (Production + Preview)
#
# DATABASE_URL → SQLite file:./dev.db NON funziona su Vercel (filesystem effimero).
# Usa Turso: DATABASE_URL + TURSO_DATABASE_URL (libsql://…) + TURSO_AUTH_TOKEN.
# Poi dalla macchina locale, con le stesse variabili:
#   npx prisma migrate deploy
#   npx prisma db seed
